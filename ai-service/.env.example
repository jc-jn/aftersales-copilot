APP_ENV=local
AI_INTERNAL_SECRET=replace-with-a-different-random-secret
JAVA_INTERNAL_SECRET=replace-with-another-random-secret
REDIS_URL=redis://:replace-with-redis-password@localhost:6379/0
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=512
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# fake=8; switch siliconflow to 1024 and use a new collection after dimension verification
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aftersales_kb_v1
EMBEDDING_DIMENSION=8
# Unset threshold means no evidence answer until calibrated with the same embedding model
# RAG_SCORE_THRESHOLD=...
JAVA_INTERNAL_BASE_URL=http://localhost:8080
RABBITMQ_URL=amqp://aftersales:replace-with-rabbitmq-password@localhost:5672/
MINIO_ENDPOINT=http://localhost:9000
